{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    ["{", "}"], ["[", "]"], ["(", ")"], ["`", "`"],
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "%", "close": "%", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["`", "`"], ["\"", "\""], ["'", "'"]],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@$^&*()=+[{}\\]\\\\|;:'\",<>/\\s]+)",
  "folding": { "markers": { "start": "^\\s*#region", "end": "^\\s*#endregion" } },
  "onEnterRules": [{
    "beforeText": "^\\s*#'\\s*[^\\s]",
    "action": { "indent": "none", "appendText": "#' " }
  }]
}
